# Copy this file to .env.local for local `vercel dev` testing, and fill in your own real keys.
# NEVER commit the file with real keys in it - .env.local is already listed in .gitignore.
#
# In production (Vercel), do NOT use this file at all - set these in the Vercel dashboard under
# Project Settings -> Environment Variables instead.

GEMINI_API_KEY=여기에_발급받은_실제_Gemini_API_키를_넣으세요

# Food nutrition-info lookup (api/nutrition-info.js), used by the diet screen's food search.
# Kept as a separate key/env var from GEMINI_API_KEY on purpose so this feature can be
# configured/rotated independently - see README.md "영양정보 API 설정".
NUTRITION_API_KEY=여기에_발급받은_실제_영양정보_API_키를_넣으세요

# Optional. Comma-separated list of origins allowed to call /api/analyze-food and
# /api/nutrition-info, or "*" (default) to allow any origin. Only needed if the frontend is
# hosted on a different domain than this API (e.g. frontend stays on GitHub Pages while only the
# backend moves to Vercel).
# ALLOWED_ORIGIN=https://shfkszldnl33-web.github.io

# Optional. Overrides the Gemini model used by api/analyze-food.js.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Overrides the model used by api/nutrition-info.js.
# NUTRITION_MODEL=gemini-3.6-flash
